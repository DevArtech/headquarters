{
  "name": "headquarters",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @hq/hq --filter @hq/web --parallel --stream run dev",
    "hq": "pnpm --filter @hq/hq dev",
    "outpost": "pnpm --filter @hq/outpost dev",
    "web": "pnpm --filter @hq/web dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
