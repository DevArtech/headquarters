# Headquarters
HQ_PORT=4800
HQ_TOKEN=change-me
# G.A.R.T.H. runs on this machine's Claude Code by default (claude auth login).
# GARTH_BRAIN=codex          # preferred brain: claude-code (default), codex, or api (needs ANTHROPIC_API_KEY); switchable per channel in the UI
# GARTH_CC_MODEL=opus        # model for the Claude Code brain (default: Claude Code's default)
# GARTH_CODEX_MODEL=         # model for the Codex brain (default: your ~/.codex/config.toml model)
# GARTH_CODEX_EFFORT=medium  # Codex reasoning effort for G.A.R.T.H. turns
# GARTH_CODEX_SANDBOX=workspace-write
# GARTH_ALLOWED_TOOLS=mcp__hq Bash Read Edit Write Glob Grep WebSearch WebFetch
# GARTH_PERMISSION_MODE=acceptEdits
# Voice: Kokoro neural TTS on this machine. Voices: am_michael (default), am_fenrir, am_puck,
# bm_george, bm_fable, af_heart, af_bella, bf_emma. GARTH_TTS=browser uses the browser voice instead.
# GARTH_VOICE=am_michael
# GARTH_VOICE_SPEED=1.05
ANTHROPIC_API_KEY=
GARTH_MODEL=claude-opus-5-5

# Outpost (remote device)
HQ_URL=ws://hq-machine:4800/ws/outpost
OUTPOST_NAME=my-laptop
